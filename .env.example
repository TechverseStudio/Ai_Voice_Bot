# =====================================================================
# AI Voice Real Estate CRM - Environment Configuration
# =====================================================================

# 1. AI Voice Services (Sarvam AI for STT/TTS & Indic Voice)
SARVAM_API_KEY=your_sarvam_api_key_here

# 2. Database Configuration (SQLite for local demo, PostgreSQL for production)
DATABASE_URL=sqlite:///data/voice_agent.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/voice_agent

# 3. Telephony Provider Selection ('exotel', 'twilio', or 'mock')
# In 'mock' mode, calls are safely simulated without carrier charges.
# Set to 'exotel' or 'twilio' to place real outbound phone calls.
TELEPHONY_PROVIDER=mock

# Public URL of this server for webhooks and audio streams (ngrok / domain):
# PUBLIC_BASE_URL=https://your-domain.ngrok-free.app
# AGENTSTREAM_PUBLIC_URL=https://your-domain.ngrok-free.app

# ---------------------------------------------------------------------
# EXOTEL CONFIGURATION (India Telecom Primary Carrier)
# ---------------------------------------------------------------------
# Required for real calls when TELEPHONY_PROVIDER=exotel:
# EXOTEL_ACCOUNT_SID=your_exotel_account_sid
# EXOTEL_API_KEY=your_exotel_api_key
# EXOTEL_API_TOKEN=your_exotel_api_token
# EXOTEL_CALLER_ID=your_exophone_number (e.g., 08047192345)
# EXOTEL_BASE_URL=https://api.exotel.com
# EXOTEL_APPLET_ID=your_applet_flow_id (optional)

# ---------------------------------------------------------------------
# TWILIO CONFIGURATION (Alternative / Bidirectional Media Stream)
# ---------------------------------------------------------------------
# Required for real calls when TELEPHONY_PROVIDER=twilio:
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+12025550199

# ---------------------------------------------------------------------
# INDIA TELECOM COMPLIANCE & CALLING HOURS
# ---------------------------------------------------------------------
# TRAI commercial calling window is enforced automatically: 09:30 to 19:30 IST.
# DND (Do Not Call) suppression is active for all outbound campaigns.
